# ──────────────────────────────────────────────────────────
# 로컬/Vercel 공통 환경변수 템플릿
# ──────────────────────────────────────────────────────────

# Supabase Postgres 연결 문자열 (Connection pooling URL 권장 — 서버리스용)
# Supabase 대시보드 → Project Settings → Database → Connection string → "Transaction" 모드
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Storage 접근용
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_BUCKET=uploads

# 어드민 로그인 비밀번호
ADMIN_PASSWORD=change-me

# CORS 허용 출처 (콤마로 여러 개)
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.vercel.app

# CORS 허용 정규식 패턴 (콤마로 여러 개). 본인 프로젝트의 vercel preview만 좁게 허용할 때 사용.
# 예: ^https://cococ-[a-z0-9-]+-cacaocoffee\.vercel\.app$
ALLOWED_ORIGIN_PATTERNS=

# 로컬 dev API 서버 포트
PORT=4000
NODE_ENV=development
