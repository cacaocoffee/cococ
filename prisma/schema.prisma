generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Archive {
  id           Int      @id @default(autoincrement())
  year         String
  semester     String   @default("")
  category     String
  title        String
  date         String
  base         String
  img          String   @default("")
  participants Int      @default(0)
  location     String   @default("")
  description  String   @default("")
  tags         String   @default("[]")
  gallery      String   @default("[]")
  recipes      String   @default("[]")
  content      String   @default("[]")
  createdAt    DateTime @default(now())
}

model Magazine {
  id            Int      @id @default(autoincrement())
  title         String
  author        String
  date          String
  readTime      String   @default("")
  excerpt       String   @default("")
  img           String   @default("")
  tags          String   @default("[]")
  magazineType  String   @default("")
  instagramUrls String   @default("[]")
  content       String   @default("[]")
  createdAt     DateTime @default(now())
}

model Application {
  id             Int      @id @default(autoincrement())
  submittedAt    DateTime @default(now())
  status         String   @default("pending")
  generation     Int      @default(0)

  name           String
  gender         String
  birthdate      String
  phone          String
  email          String
  sns            String   @default("")

  mtAvailable    String   @default("")
  mainContact    String   @default("")
  availableTimes String   @default("[]")
  interviewTimes String   @default("[]")

  scaleGourmet   Int      @default(0)
  scalePeople    Int      @default(0)
  q3_1_style     String   @default("")
  q1_intro       String   @default("")
  q2_drink       String   @default("")
  q3_2_reason    String   @default("")
  qEtc           String   @default("")

  // 지금 웹 지원 양식이 보내는 항목 (위의 scaleGourmet~q3_2_reason은 예전 양식의 항목)
  howKnow           String  @default("")
  scaleDesignTool   Int?
  mainDesign        String  @default("")
  scaleCameraTool   Int?
  mainProject       String  @default("")
  q2_motivation     String  @default("")
  q3_drink          String  @default("")
  q4_contribution   String  @default("")
  // 어드민이 확정한 면접 시간 (`날짜__시간`). 정하지 않았으면 null
  interviewSchedule String?
}

model Schedule {
  id        Int     @id @default(autoincrement())
  title     String
  date      String
  endDate   String  @default("")
  type      String
  archiveId Int?
}

model InterviewSetting {
  id             Int    @id @default(1)
  mtDate         String @default("")
  interviewDates String @default("[]")
  interviewTimes String @default("[]")
}

model ApplyPeriod {
  id          Int     @id @default(1)
  start       String  @default("")
  end         String  @default("")
  forceClosed Boolean @default(false)
  generation  Int     @default(1)
}

model AdminToken {
  token     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ── 인사(회원·회비) ───────────────────────────────────────
// 회비 앱(안드로이드)과 어드민의 `회원`·`회비` 탭이 함께 쓰는 표.

// 동아리 회원. 지원서가 최종 합격하면 여기로 옮겨 등록한다.
model Member {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String   @default("")
  generation    Int      @default(0)
  // 직책. 일반 회원은 빈 문자열.
  role          String   @default("")
  // active: 활동 중 / paused: 쉬는 중(회비 부과 안 함) / left: 탈퇴
  status        String   @default("active")
  // 회비를 내기 시작하는 달 (YYYY-MM)
  joinedMonth   String
  // 회비 부과를 멈춘 달 (YYYY-MM). 이 달부터는 부과하지 않는다. 비어 있으면 계속 부과.
  stoppedMonth  String   @default("")
  // 이 회원만 월 회비가 다를 때. null이면 설정의 월 회비를 쓴다.
  monthlyFee    Int?
  // 부과액에서 빼 줄 금액(면제·감면). 사유는 memo에 적는다.
  waivedAmount  Int      @default(0)
  // 입금자명이 이름과 다를 때 맞춰 볼 다른 이름들 (JSON 문자열 배열)
  depositNames  String   @default("[]")
  memo          String   @default("")
  applicationId Int?     @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deposits  DuesDeposit[]
  reminders DuesReminder[]

  @@index([status])
}

// 회비 계좌에 들어온 입금 한 건.
model DuesDeposit {
  id            Int      @id @default(autoincrement())
  depositedAt   DateTime
  amount        Int
  depositorName String
  // notification: 앱이 읽은 입금 알림 / manual: 직접 입력
  source        String   @default("notification")
  // 알림 원문. 파서가 틀렸을 때 사람이 다시 확인할 수 있게 그대로 둔다.
  rawTitle      String   @default("")
  rawBody       String   @default("")
  // 같은 입금이 두 번 올라오지 않게 막는 값
  dedupeKey     String   @unique
  memberId      Int?
  // auto: 이름으로 자동 연결 / manual: 사람이 연결 / 빈 문자열: 연결 안 됨
  matchedBy     String   @default("")
  // 회비가 아닌 입금(환불·기타)으로 표시하면 미연결 목록에서 빠진다
  ignored       Boolean  @default(false)
  createdAt     DateTime @default(now())

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([depositedAt])
}

// 독촉 문자 발송 기록. 같은 회원에게 같은 달 같은 시점의 독촉은 한 번만 나가게 한다.
model DuesReminder {
  id        Int      @id @default(autoincrement())
  memberId  Int
  // 어느 달 회비에 대한 독촉인지 (YYYY-MM)
  month     String
  // d-3 / d0 / d+1 처럼 마감일 기준 시점, 직접 보낸 것은 manual-<시각>
  kind      String
  body      String   @default("")
  // 테스트 모드에서 기록만 남긴 것인지
  testMode  Boolean  @default(false)
  sentAt    DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, month, kind])
  @@index([month])
}

// 회비 규칙 (단일 레코드)
model HrSetting {
  id              Int    @id @default(1)
  clubName        String @default("코콕")
  monthlyFee      Int    @default(40000)
  // 매달 회비 마감일
  dueDay          Int    @default(9)
  // 마감일 기준 독촉 시점 (JSON 숫자 배열). -3은 3일 전, 1은 하루 뒤.
  reminderOffsets String @default("[-3,0,1]")
  // 문자를 보내도 되는 시간대 (시)
  sendStartHour   Int    @default(9)
  sendEndHour     Int    @default(20)
  // 문자와 공지에 넣는 계좌 안내 문구
  accountInfo     String @default("")
  // 공지에 붙이는 회칙 조항 문구
  noticeClause    String @default("")
}

// 회비 앱을 설치한 기기. 토큰은 해시만 저장한다.
model HrDevice {
  id         Int       @id @default(autoincrement())
  label      String    @default("")
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}
